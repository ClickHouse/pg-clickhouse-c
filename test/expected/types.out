-- Verify PostgreSQL to ClickHouse declarations and String conversions
SET lc_monetary = 'C';
SET TimeZone = 'UTC';
SET DateStyle = 'ISO, MDY';
SET IntervalStyle = 'postgres';
-- Verify default type mapping, array elements nullable under either flag
SELECT d AS pg_type, pgch_chtype(d, true) AS notnull, pgch_chtype(d) AS nullable
FROM unnest(ARRAY[
    'bool', 'int2', 'int4', 'int8', 'oid', 'xid8', 'float4', 'float8',
    'numeric', 'numeric(12,6)', 'numeric(9)', 'numeric(80,2)',
    'text', 'varchar(8)', 'bpchar(6)', 'name', '"char"', 'bytea',
    'date', 'time', 'timestamp', 'timestamptz', 'timetz', 'interval',
    'uuid', 'json', 'jsonb',
    'inet', 'cidr', 'macaddr', 'macaddr8', 'bit(4)', 'varbit(6)',
    'point', 'lseg', 'path', 'polygon', 'box', 'circle', 'line',
    'money', 'tsvector', 'tsquery', 'jsonpath',
    'int4[]', 'text[]', 'numeric(12,6)[]', 'interval[]',
    'polygon[]', 'box[]'
]) AS d;
     pg_type     |                    notnull                    |                     nullable                     
-----------------+-----------------------------------------------+--------------------------------------------------
 bool            | Bool                                          | Nullable(Bool)
 int2            | Int16                                         | Nullable(Int16)
 int4            | Int32                                         | Nullable(Int32)
 int8            | Int64                                         | Nullable(Int64)
 oid             | UInt32                                        | Nullable(UInt32)
 xid8            | UInt64                                        | Nullable(UInt64)
 float4          | Float32                                       | Nullable(Float32)
 float8          | Float64                                       | Nullable(Float64)
 numeric         | Decimal256(38)                                | Nullable(Decimal256(38))
 numeric(12,6)   | Decimal(12,6)                                 | Nullable(Decimal(12,6))
 numeric(9)      | Decimal(9,0)                                  | Nullable(Decimal(9,0))
 numeric(80,2)   | Decimal256(38)                                | Nullable(Decimal256(38))
 text            | String                                        | Nullable(String)
 varchar(8)      | String                                        | Nullable(String)
 bpchar(6)       | String                                        | Nullable(String)
 name            | String                                        | Nullable(String)
 "char"          | String                                        | Nullable(String)
 bytea           | String                                        | Nullable(String)
 date            | Date32                                        | Nullable(Date32)
 time            | Time64(6)                                     | Nullable(Time64(6))
 timestamp       | DateTime64(6, 'UTC')                          | Nullable(DateTime64(6, 'UTC'))
 timestamptz     | DateTime64(6, 'UTC')                          | Nullable(DateTime64(6, 'UTC'))
 timetz          | String                                        | Nullable(String)
 interval        | String                                        | Nullable(String)
 uuid            | UUID                                          | Nullable(UUID)
 json            | String                                        | Nullable(String)
 jsonb           | String                                        | Nullable(String)
 inet            | String                                        | Nullable(String)
 cidr            | String                                        | Nullable(String)
 macaddr         | String                                        | Nullable(String)
 macaddr8        | String                                        | Nullable(String)
 bit(4)          | String                                        | Nullable(String)
 varbit(6)       | String                                        | Nullable(String)
 point           | Point                                         | Nullable(Point)
 lseg            | LineString                                    | LineString
 path            | LineString                                    | LineString
 polygon         | Ring                                          | Ring
 box             | Tuple(high Point, low Point)                  | Nullable(Tuple(high Point, low Point))
 circle          | Tuple(center Point, radius Float64)           | Nullable(Tuple(center Point, radius Float64))
 line            | Tuple(a Float64, b Float64, c Float64)        | Nullable(Tuple(a Float64, b Float64, c Float64))
 money           | String                                        | Nullable(String)
 tsvector        | String                                        | Nullable(String)
 tsquery         | String                                        | Nullable(String)
 jsonpath        | String                                        | Nullable(String)
 int4[]          | Array(Nullable(Int32))                        | Array(Nullable(Int32))
 text[]          | Array(Nullable(String))                       | Array(Nullable(String))
 numeric(12,6)[] | Array(Nullable(Decimal(12,6)))                | Array(Nullable(Decimal(12,6)))
 interval[]      | Array(Nullable(String))                       | Array(Nullable(String))
 polygon[]       | Array(Ring)                                   | Array(Ring)
 box[]           | Array(Nullable(Tuple(high Point, low Point))) | Array(Nullable(Tuple(high Point, low Point)))
(50 rows)

-- Verify optional JSON, LowCardinality, and numeric mappings
SELECT pgch_chtype('jsonb', json_as_json => true) AS json_null,
       pgch_chtype('jsonb', true, json_as_json => true) AS json_notnull,
       pgch_chtype('text', low_cardinality => true) AS lc_null,
       pgch_chtype('text', true, low_cardinality => true) AS lc_notnull,
       pgch_chtype('numeric', numeric_as_string => true) AS num_string;
 json_null | json_notnull |             lc_null              |       lc_notnull       |    num_string    
-----------+--------------+----------------------------------+------------------------+------------------
 JSON      | JSON         | LowCardinality(Nullable(String)) | LowCardinality(String) | Nullable(String)
(1 row)

-- Map domains through base type and typmod
CREATE DOMAIN dcount AS int4;
CREATE DOMAIN dvc AS varchar(8);
SELECT pgch_chtype('dcount', true), pgch_chtype('dvc', true), pgch_chtype('dcount[]', true);
 pgch_chtype | pgch_chtype |      pgch_chtype       
-------------+-------------+------------------------
 Int32       | String      | Array(Nullable(Int32))
(1 row)

-- Decode generated ClickHouse declarations into compatible PostgreSQL types
SELECT d AS pg_type, c AS ch_type, pgch_pgtype(c) AS decodes_as
FROM (SELECT d, pgch_chtype(d, true) AS c FROM unnest(ARRAY[
    'bool', 'int2', 'int4', 'int8', 'oid', 'xid8', 'float4', 'float8',
    'numeric(12,6)', 'text', 'date', 'time', 'timestamptz', 'uuid',
    'int4[]', 'text[]',
    'point', 'lseg', 'path', 'polygon', 'box', 'circle', 'line', 'polygon[]'
]) AS d) q;
    pg_type    |                ch_type                 |        decodes_as        
---------------+----------------------------------------+--------------------------
 bool          | Bool                                   | boolean
 int2          | Int16                                  | smallint
 int4          | Int32                                  | integer
 int8          | Int64                                  | bigint
 oid           | UInt32                                 | bigint
 xid8          | UInt64                                 | bigint
 float4        | Float32                                | real
 float8        | Float64                                | double precision
 numeric(12,6) | Decimal(12,6)                          | numeric
 text          | String                                 | text
 date          | Date32                                 | date
 time          | Time64(6)                              | time without time zone
 timestamptz   | DateTime64(6, 'UTC')                   | timestamp with time zone
 uuid          | UUID                                   | uuid
 int4[]        | Array(Nullable(Int32))                 | integer[]
 text[]        | Array(Nullable(String))                | text[]
 point         | Point                                  | point
 lseg          | LineString                             | path
 path          | LineString                             | path
 polygon       | Ring                                   | polygon
 box           | Tuple(high Point, low Point)           | record
 circle        | Tuple(center Point, radius Float64)    | record
 line          | Tuple(a Float64, b Float64, c Float64) | record
 polygon[]     | Array(Ring)                            | polygon[]
(24 rows)

-- Round-trip PostgreSQL types represented by ClickHouse String
CREATE FUNCTION rt(lit text, typ text, ch text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE res text;
BEGIN
    EXECUTE format('SELECT pgch_roundtrip_as(%L, %s::%s)', ch, lit, typ) INTO res;
    RETURN res;
END $$;
CREATE TYPE mood AS ENUM ('sad', 'ok', 'happy');
SELECT typ, rt(lit, typ, ch) AS scalar, rt(arr, typ || '[]', 'Array(' || ch || ')') AS array
FROM (VALUES
    ('''1 day 02:03:04''',      'ARRAY[''1 day'', ''2 hours'']',      'interval', 'String'),
    ('''12:34:56+02''',         'ARRAY[''12:34:56+02'']',             'timetz',   'String'),
    ('''a b''',                 'ARRAY[''a b'']',                     'tsvector', 'String'),
    ('''a & b''',               'ARRAY[''a & b'']',                   'tsquery',  'String'),
    ('''$.a[0]''',              'ARRAY[''$.a[0]'']',                  'jsonpath', 'String'),
    ('''3.00''',                'ARRAY[''3.00'', ''-4.50'']',         'money',    'String'),
    ('''08:00:2b:01:02:03''',   'ARRAY[''08:00:2b:01:02:03'']',       'macaddr',  'String'),
    ('''08:00:2b:01:02:03:04:05''', 'ARRAY[''08:00:2b:01:02:03:04:05'']', 'macaddr8', 'String'),
    ('''10.0.0.0/8''',          'ARRAY[''10.0.0.0/8'', ''::1/128'']',  'cidr',     'String'),
    ('B''1010''',               'ARRAY[B''1010'']',                   'bit(4)',   'String'),
    ('B''101''',                'ARRAY[B''101'']',                    'varbit',   'String'),
    ('''(1,2)''',               'ARRAY[''(1,2)'']',                   'point',    'String'),
    ('''((0,0),(1,1),(2,0))''', 'ARRAY[''((0,0),(1,1))'']',           'polygon',  'String'),
    ('''<(1,2),3>''',           'ARRAY[''<(1,2),3>'']',               'circle',   'String'),
    ('''ok''',                  'ARRAY[''ok'', ''sad'']',             'mood',     'String'),
    ('''ok''',                  'ARRAY[''ok'', ''sad'']',             'mood',     'LowCardinality(String)')
) v(lit, arr, typ, ch);
   typ    |         scalar          |           array           
----------+-------------------------+---------------------------
 interval | 1 day 02:03:04          | {"1 day",02:00:00}
 timetz   | 12:34:56+02             | {12:34:56+02}
 tsvector | 'a' 'b'                 | {"'a' 'b'"}
 tsquery  | 'a' & 'b'               | {"'a' & 'b'"}
 jsonpath | $."a"[0]                | {"$.\"a\"[0]"}
 money    | $3.00                   | {$3.00,-$4.50}
 macaddr  | 08:00:2b:01:02:03       | {08:00:2b:01:02:03}
 macaddr8 | 08:00:2b:01:02:03:04:05 | {08:00:2b:01:02:03:04:05}
 cidr     | 10.0.0.0/8              | {10.0.0.0/8,::1/128}
 bit(4)   | 1010                    | {1010}
 varbit   | 101                     | {101}
 point    | (1,2)                   | {"(1,2)"}
 polygon  | ((0,0),(1,1),(2,0))     | {"((0,0),(1,1))"}
 circle   | <(1,2),3>               | {"<(1,2),3>"}
 mood     | ok                      | {ok,sad}
 mood     | ok                      | {ok,sad}
(16 rows)

-- Prepare conversion from schema before nullable rows
SELECT pgch_decode_typed(pgch_encode_rows('Nullable(String)',
                                          ARRAY[NULL, '1 day']::text[]),
                         NULL::interval),
       pgch_decode_typed(pgch_encode_rows('Nullable(String)',
                                          ARRAY[NULL, NULL]::text[]),
                         NULL::interval),
       pgch_decode_typed(pgch_encode('Array(Int64)', ARRAY[1, 2]::int8[]),
                         NULL::int4[]);
 pgch_decode_typed | pgch_decode_typed | pgch_decode_typed 
-------------------+-------------------+-------------------
 {NULL,"1 day"}    | {NULL,NULL}       | {"{1,2}"}
(1 row)

-- Convert array elements into requested PostgreSQL type
SELECT pgch_decode_as(pgch_encode('Array(Int64)', ARRAY[1, 2, 3]::int8[]), NULL::int4[]),
       pgch_decode_as(pgch_encode('Array(Array(Int64))', ARRAY[[1, 2], [3, 4]]::int8[]),
                      NULL::int4[]),
       pgch_decode_as(pgch_encode('Array(Nullable(String))',
                                  ARRAY['1 day', NULL]::text[]), NULL::interval[]);
 pgch_decode_as |  pgch_decode_as   |    pgch_decode_as    
----------------+-------------------+----------------------
 {"{1,2,3}"}    | {"{{1,2},{3,4}}"} | {"{\"1 day\",NULL}"}
(1 row)

-- Convert arrays into array domains
CREATE DOMAIN dints AS int4[];
SELECT pgch_decode_as(pgch_encode('Array(Int32)', ARRAY[1, 2]::int4[]), NULL::dints),
       pgch_decode_as(pgch_encode('Array(Int64)', ARRAY[1, 2]::int8[]), NULL::dints);
 pgch_decode_as | pgch_decode_as 
----------------+----------------
 {"{1,2}"}      | {"{1,2}"}
(1 row)

-- Round-trip relation through generated structure and slot API
CREATE TABLE copyshape (
    id      int          NOT NULL,
    name    varchar(16),
    amount  numeric(9,2),
    ival    interval,
    mac     macaddr,
    ip      inet,
    when_   timestamptz,
    day     date,
    tags    text[],
    counts  int8[]       NOT NULL,
    doc     jsonb
);
INSERT INTO copyshape VALUES
    (1, 'first', 12.34, '1 day 02:03:04', '08:00:2b:01:02:03', '10.0.0.1',
     '2024-01-15 12:34:56.123456+00', '2024-01-15', ARRAY['a', 'b c'],
     ARRAY[1, 2, 3], '{"a": [1, 2]}'),
    (2, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, ARRAY[]::int8[], NULL);
SELECT pgch_structure('copyshape');
                                                                                                                                 pgch_structure                                                                                                                                  
---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 id Int32, name Nullable(String), amount Nullable(Decimal(9,2)), ival Nullable(String), mac Nullable(String), ip Nullable(String), when_ Nullable(DateTime64(6, 'UTC')), day Nullable(Date32), tags Array(Nullable(String)), counts Array(Nullable(Int64)), doc Nullable(String)
(1 row)

SELECT unnest(pgch_table_roundtrip('copyshape', null_array_empty => true));
                                                              unnest                                                              
----------------------------------------------------------------------------------------------------------------------------------
 1|first|12.34|1 day 02:03:04|08:00:2b:01:02:03|10.0.0.1|2024-01-15 12:34:56.123456+00|2024-01-15|{a,"b c"}|{1,2,3}|{"a": [1, 2]}
 2|NULL|NULL|NULL|NULL|NULL|NULL|NULL|{}|{}|NULL
(2 rows)

-- Generate structure with optional mappings
SELECT pgch_structure('copyshape', json_as_json => true, low_cardinality => true);
                                                                                                                                                                   pgch_structure                                                                                                                                                                    
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 id Int32, name LowCardinality(Nullable(String)), amount Nullable(Decimal(9,2)), ival LowCardinality(Nullable(String)), mac LowCardinality(Nullable(String)), ip LowCardinality(Nullable(String)), when_ Nullable(DateTime64(6, 'UTC')), day Nullable(Date32), tags Array(LowCardinality(Nullable(String))), counts Array(Nullable(Int64)), doc JSON
(1 row)

-- Skip dropped columns consistently
ALTER TABLE copyshape DROP COLUMN mac;
SELECT pgch_structure('copyshape');
                                                                                                                      pgch_structure                                                                                                                       
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 id Int32, name Nullable(String), amount Nullable(Decimal(9,2)), ival Nullable(String), ip Nullable(String), when_ Nullable(DateTime64(6, 'UTC')), day Nullable(Date32), tags Array(Nullable(String)), counts Array(Nullable(Int64)), doc Nullable(String)
(1 row)

SELECT unnest(pgch_table_roundtrip('copyshape', null_array_empty => true));
                                                     unnest                                                     
----------------------------------------------------------------------------------------------------------------
 1|first|12.34|1 day 02:03:04|10.0.0.1|2024-01-15 12:34:56.123456+00|2024-01-15|{a,"b c"}|{1,2,3}|{"a": [1, 2]}
 2|NULL|NULL|NULL|NULL|NULL|NULL|{}|{}|NULL
(2 rows)

-- Carry a NULL ring or line as the empty one, which PostgreSQL cannot spell
CREATE TABLE geoshape (poly polygon, p path, ls lseg, b box, polys polygon[]);
INSERT INTO geoshape VALUES
    ('((0,0),(1,1),(2,0))', '[(0,0),(1,1)]', '((1,1),(2,2))', '((1,1),(3,3))',
     ARRAY['((0,0),(1,1),(2,0))', NULL]::polygon[]),
    (NULL, NULL, NULL, NULL, NULL);
SELECT pgch_structure('geoshape');
                                           pgch_structure                                            
-----------------------------------------------------------------------------------------------------
 poly Ring, p LineString, ls LineString, b Nullable(Tuple(high Point, low Point)), polys Array(Ring)
(1 row)

SELECT unnest(pgch_table_roundtrip('geoshape', null_array_empty => true));
                                          unnest                                          
------------------------------------------------------------------------------------------
 ((0,0),(1,1),(2,0))|[(0,0),(1,1)]|[(1,1),(2,2)]|(3,3),(1,1)|{"((0,0),(1,1),(2,0))",NULL}
 NULL|NULL|NULL|NULL|{}
(2 rows)

-- Keep non-finite values, which Float columns take
SELECT pgch_roundtrip('Float64', 'NaN'::float8) AS float_keeps_nan;
 float_keeps_nan 
-----------------
 NaN
(1 row)

SELECT pgch_roundtrip('Float32', '-Infinity'::float4) AS float_keeps_inf;
 float_keeps_inf 
-----------------
 -Infinity
(1 row)

-- Return required Native query settings
SELECT pgch_native_settings();
                                       pgch_native_settings                                       
--------------------------------------------------------------------------------------------------
 output_format_native_encode_types_in_binary_format=0,output_format_native_write_json_as_string=1
(1 row)

